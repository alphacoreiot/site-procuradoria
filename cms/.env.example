# Copie para .env e ajuste.
# SQLite (testes):     DATABASE_URL="file:./dev.db"
# PostgreSQL (prod.):  DATABASE_URL="postgresql://usuario:senha@host:5432/cms?schema=public"
DATABASE_URL="file:./dev.db"

# Pasta de uploads e cache de imagens (fora de public/). Em produção, use um volume persistente.
STORAGE_DIR="./storage"

# Usuário inicial da Prefeitura (SUPERADMIN) criado pelo seed. Senha com 12+ caracteres.
SEED_ADMIN_EMAIL="admin@camacari.ba.gov.br"
SEED_ADMIN_PASSWORD="troque-por-uma-senha-forte"
